{
  "manifest_version": 3,
  "name": "EV.IO UI Enhancer",
  "version": "3.1",
  "description": "Enhances ev.io with a lobby browser and player-hosted custom lobbies — host or join matches peer-to-peer, with live settings.",
  "permissions": ["storage", "tabs", "offscreen"],
  "host_permissions": [
    "https://ev.io/*",
    "https://*.rivet.game/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ev.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-socket-hook.js"],
      "matches": ["https://ev.io/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "EV.IO UI Enhancer"
  }
}